---
// CoSky's case: reads stay in-process; Redis Pub/Sub keeps the cache fresh.
import { copy, t, type Locale } from "../../content";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const f = copy.figures.cache;
---

<figure class="figure" aria-labelledby="cache-title">
  <div class="figure-bar"><span id="cache-title">{t(f.title, locale)}</span><span>0 RTT</span></div>
  <svg viewBox="0 0 280 246" role="img" aria-labelledby="cache-svg-title cache-svg-desc">
    <title id="cache-svg-title">{t(f.title, locale)}</title>
    <desc id="cache-svg-desc">{t(f.description, locale)}</desc>

    <g class="box">
      <rect x="8" y="8" width="264" height="124" rx="12" />
      <text class="box-label" x="20" y="28">application</text>
    </g>
    <g class="node">
      <rect x="20" y="44" width="76" height="48" rx="10" />
      <text class="node-label" x="58" y="73" text-anchor="middle">get()</text>
    </g>
    <g class="node hot">
      <rect x="124" y="44" width="136" height="48" rx="10" />
      <text class="node-label" x="192" y="65" text-anchor="middle">local cache</text>
      <text class="node-sub" x="192" y="82" text-anchor="middle">in-process</text>
    </g>
    <g class="node">
      <rect x="124" y="190" width="136" height="48" rx="10" />
      <text class="node-label" x="192" y="211" text-anchor="middle">Redis</text>
      <text class="node-sub" x="192" y="228" text-anchor="middle">source of truth</text>
    </g>

    <path class="wire" d="M96 68 H124" />
    <path class="packet fast" d="M96 68 H124" pathLength="100" />
    <path class="wire" d="M160 190 V92" />
    <path class="packet" d="M160 190 V92" pathLength="100" />
    <path class="wire dashed" d="M196 92 V190" />

    <text class="wire-label hot-label" x="140" y="118" text-anchor="middle">hot path · no network</text>
    <text class="wire-label" x="152" y="164" text-anchor="end">Pub/Sub</text>
    <text class="wire-label" x="204" y="164">write / miss</text>
  </svg>
</figure>
